    "stem": "The diagram shows Imran's number line from $4000$ to $6000$. The interval is divided into four equal parts with marks at equal spacing.",
    "item_type": "structured",
    "options": {},
    "statements": [],
    "parts": [
      {
        "id": "i",
        "text": "Which claim correctly reads the second mark after $4000$?",
        "marks": 1,
        "options": [
          {
            "id": "A",
            "text": "The second mark after $4000$ shows $5000$, because each equal part is $500$."
          },
          {
            "id": "B",
            "text": "The second mark after $4000$ shows $4002$, treating each mark as one unit."
          },
          {
            "id": "C",
            "text": "Reading $5000$ on the mark is what creates the equal spacing on the number line."
          }
        ]
      },
      {
        "id": "ii",
        "text": "Give one reason for your choice.",
        "marks": 1
      }
    ],
