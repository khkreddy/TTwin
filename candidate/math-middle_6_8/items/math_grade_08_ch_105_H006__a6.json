    "stem": "Neel wants to prove that $360$ is divisible by $36$. He knows $36=2^{2}\\times 3^{2}$.",
    "item_type": "structured",
    "options": {},
    "statements": [],
    "parts": [
      {
        "id": "i",
        "text": "Which claim is correct?",
        "marks": 1,
        "options": [
          {
            "id": "A",
            "text": "Tests that together supply $2^{2}$ and $3^{2}$ — for example divisible by $4$ and by $9$ — prove divisibility by $36$, since $\\mathrm{lcm}(4,9)=36$."
          },
          {
            "id": "B",
            "text": "A check that $360$ is divisible by $2$ alone proves divisibility by $36$."
          },
          {
            "id": "C",
            "text": "Proving divisibility by $36$ forces the prime factors $2^{2}$ and $3^{2}$ into place, reversing the test direction."
          },
          {
            "id": "D",
            "text": "Checks that $360$ is divisible by $2$ and by $3$ prove divisibility by $36$."
          }
        ]
      },
      {
        "id": "ii",
        "text": "Give one reason for your choice.",
        "marks": 1
      }
    ],
