    "stem": "Alok has $\\triangle XYZ$ with a right angle at $Y$, $XY=9$, and $YZ=12$. He wants the length of $XZ$.",
    "item_type": "structured",
    "options": {},
    "statements": [],
    "parts": [
      {
        "id": "i",
        "text": "Which claim correctly applies $a^{2}+b^{2}=c^{2}$?",
        "marks": 1,
        "options": [
          {
            "id": "A",
            "text": "$XZ$ is the hypotenuse opposite the right angle, so $9^{2}+12^{2}=XZ^{2}$ and $XZ=15$."
          },
          {
            "id": "B",
            "text": "Apply $9^{2}+12^{2}=XZ^{2}$ even when the right-angle mark at $Y$ is removed."
          },
          {
            "id": "C",
            "text": "Writing $9^{2}+12^{2}=XZ^{2}$ forces the right angle at $Y$ into place."
          },
          {
            "id": "D",
            "text": "Treat $XY$ as the hypotenuse, so $12^{2}+XZ^{2}=9^{2}$."
          }
        ]
      },
      {
        "id": "ii",
        "text": "Give one reason for your choice.",
        "marks": 1
      }
    ],
