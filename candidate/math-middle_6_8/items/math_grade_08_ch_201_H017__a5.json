    "stem": "Vidya is told that mass $P$ is $20\\%$ of mass $Q$.\n\nShe wants what percent $Q$ is of $P$.",
    "item_type": "structured",
    "options": {},
    "statements": [],
    "parts": [
      {
        "id": "i",
        "text": "Which claim correctly states what percent $Q$ is of $P$?",
        "marks": 1,
        "options": [
          {
            "id": "A",
            "text": "$Q$ is $80\\%$ of $P$, because $100-20=80$."
