        "id": "i",
        "text": "Which claim correctly gives the fewest clicks?",
        "marks": 1,
        "options": [
          {
            "id": "A",
            "text": "Press $+1000$ twice, $+100$ eight times, and $+1$ four times — $14$ clicks in all."
          },
          {
            "id": "B",
            "text": "Press $+1$ a total of $2804$ times, because any sequence of buttons is allowed without using place value."
          },
          {
            "id": "C",
            "text": "The fewest-click count is the printed label Systematic Sippy."
          },
          {
            "id": "D",
            "text": "Press $+1000$ twice and stop at $2000$, treating the remaining digits as optional."
