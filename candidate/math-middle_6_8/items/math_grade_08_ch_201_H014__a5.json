    "stem": "Radha invests $\\mathrm{Rs}\\,6000$ at $8\\%$ per year, compounded annually, for $2$ years.",
    "item_type": "structured",
    "options": {},
    "statements": [],
    "parts": [
      {
        "id": "i",
        "text": "Which claim correctly gives the amount after $2$ years?",
        "marks": 1,
        "options": [
          {
            "id": "A",
            "text": "After year $1$ the amount is $\\mathrm{Rs}\\,6480$; year $2$ interest is taken on $\\mathrm{Rs}\\,6480$, so the amount is $\\mathrm{Rs}\\,6480\\times 1.08=\\mathrm{Rs}\\,6998.40$."
          },
          {
            "id": "B",
            "text": "Each year adds $\\mathrm{Rs}\\,480$ on the original $\\mathrm{Rs}\\,6000$ only, so the amount is $\\mathrm{Rs}\\,6960$."
          },
          {
            "id": "C",
            "text": "Compounding also covers interest paid out each year with the principal kept fixed at $\\mathrm{Rs}\\,6000$."
          }
        ]
      },
      {
        "id": "ii",
        "text": "Give one reason for your choice.",
        "marks": 1
      }
