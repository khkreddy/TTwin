    "stem": "Gaurav records points in six games: $9$, $0$, $14$, dash (did not play), $7$, and $10$. He wants the mean points per game played.",
    "item_type": "structured",
    "options": {},
    "statements": [],
    "parts": [
      {
        "id": "i",
        "text": "Which claim correctly forms the mean?",
        "marks": 1,
        "options": [
          {
            "id": "A",
            "text": "Drop both the observed $0$ and the dash, treating each as a no-value label."
          },
          {
            "id": "B",
            "text": "Sum $9+0+14+7+10=40$ over the five played games, so the mean is $40/5$; exclude the dash."
          },
          {
            "id": "C",
            "text": "Average six entries by counting the dash as a played game with a blank score."
          }
        ]
      },
      {
        "id": "ii",
        "text": "Give one reason for your choice.",
