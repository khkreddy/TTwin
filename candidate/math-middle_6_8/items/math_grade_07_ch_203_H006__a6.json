    "stem": "Tejas hears two bells: one every $10$ minutes and one every $15$ minutes. They ring together at $8{:}00$. He wants the next time they ring together.",
    "item_type": "structured",
    "options": {},
    "statements": [],
    "parts": [
      {
        "id": "i",
        "marks": 1,
        "text": "Which claim correctly finds the next shared ring?",
        "options": [
          {
            "id": "A",
            "text": "Any common multiple such as $60$ minutes is the next shared ring, with no need for the least."
          },
          {
            "id": "B",
            "text": "The next shared ring is after $\\operatorname{lcm}(10,15)=30$ minutes, so at $8{:}30$."
          },
          {
            "id": "C",
            "text": "Add $10$ and $15$ to get $25$ minutes, and use $25$ minutes as the wait."
          }
        ]
      },
      {
        "id": "ii",
        "marks": 1,
        "text": "Give one reason for your choice."
      }
