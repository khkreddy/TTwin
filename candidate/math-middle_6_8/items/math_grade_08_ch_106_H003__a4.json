    "stem": "Diya starts with the product $8 \\times 11$. The factors are then changed to $10 \\times 13$.",
    "item_type": "structured",
    "options": {},
    "statements": [],
    "parts": [
      {
        "id": "i",
        "text": "By how much does the product increase?",
        "marks": 1,
        "options": [
          {
            "id": "A",
            "text": "By $16$, from the $8\\times2$ change term alone."
          },
          {
            "id": "B",
            "text": "By the adjustments $+2$ and $+2$ to the factors."
          },
          {
            "id": "C",
            "text": "By $42$, because $(8+2)(11+2)=8\\times11 + 8\\times2 + 11\\times2 + 2\\times2$ and the change is $16+22+4=42$."
