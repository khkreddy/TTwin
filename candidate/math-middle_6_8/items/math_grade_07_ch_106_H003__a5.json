    "stem": "Ekta has nine odd-numbered cards. She wants to place all nine cards so that their sum is exactly $50$.",
    "item_type": "structured",
    "options": {},
    "statements": [],
    "parts": [
      {
        "id": "i",
        "text": "What can she decide before trying any cases?",
        "marks": 1,
        "options": [
          {
            "id": "A",
            "text": "The sum of nine odd numbers is odd, so it cannot equal $50$."
          },
          {
            "id": "B",
            "text": "The sum of nine odd numbers is even, so $50$ is reachable."
          },
          {
            "id": "C",
            "text": "Parity does not apply until she first chooses which cards make the total."
          },
          {
            "id": "D",
            "text": "Any nine positive cards can make $50$ if their sizes are small enough."
          }
        ]
      },
