    "stem": "Abhay reads the base-ten numeral $405$. He compares giving every digit a fixed value with reading each digit by its place.",
    "item_type": "structured",
    "options": {},
    "statements": [],
    "parts": [
      {
        "id": "i",
        "text": "Which claim correctly explains how place value reads $405$?",
        "marks": 1,
        "options": [
          {
            "id": "A",
            "text": "$405$ means $4\\times100+0\\times10+5\\times1$, so the digit $4$ counts hundreds because of its position."
          },
          {
            "id": "B",
            "text": "Each digit always means the same absolute amount, so the $4$ in $405$ equals the $4$ in $4$."
          },
          {
            "id": "C",
            "text": "Position is ignored; the numeral is read by adding the digit symbols $4$, $0$, and $5$ alone."
          }
        ]
      },
      {
        "id": "ii",
        "text": "Give one reason for your choice.",
        "marks": 1
      }
