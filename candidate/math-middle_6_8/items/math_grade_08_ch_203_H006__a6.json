    "options": {
      "A": "1 and 2 only",
      "B": "1 and 3 only",
      "C": "2 and 3 only",
      "D": "1, 2 and 3"
    },
    "statements": [
      {
        "id": "1",
        "text": "Treat crews and days as inverse proportion: more crews mean fewer days for the same road."
      },
      {
        "id": "2",
        "text": "For a fixed road, crews $\\times$ days stays constant, so doubling the crews halves the days."
      },
      {
        "id": "3",
        "text": "Treat crews and days as direct proportion, because both quantities should rise together."
      }
