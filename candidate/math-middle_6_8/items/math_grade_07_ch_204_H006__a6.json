    "stem": "Urvashi asks whether $\\dfrac{11}{50}$ can be written as a terminating decimal by finding an equivalent fraction with denominator $10$, $100$, $1000$, and so on.",
    "item_type": "structured",
    "options": {},
    "statements": [],
    "parts": [
      {
        "id": "i",
        "marks": 1,
        "text": "Which claim is correct?",
        "options": [
          {
            "id": "A",
            "text": "$\\dfrac{11}{50}$ cannot become a terminating decimal because $50$ is not already $10$, $100$, or $1000$."
          },
          {
            "id": "B",
            "text": "Yes: multiply numerator and denominator by $2$ to get $\\dfrac{22}{100}=0.22$, a terminating decimal."
          },
          {
            "id": "C",
            "text": "The terminating decimal $0.22$ must be written first, and only then can the fraction $\\dfrac{11}{50}$ appear."
          }
        ]
      },
