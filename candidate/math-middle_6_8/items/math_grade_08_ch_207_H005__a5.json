    "stem": "Javed has triangle $ABC$ with $AB=12$ cm. From $C$ he draws a perpendicular to the line through $AB$, meeting it at $H$, and measures $CH=4$ cm.",
    "item_type": "three_statement",
    "options": {
      "A": "1 and 2 only",
      "B": "1 and 3 only",
      "C": "2 and 3 only",
      "D": "1, 2 and 3"
    },
    "statements": [
      {
        "id": "1",
        "text": "Base $AB=12$ cm and perpendicular height $CH=4$ cm give area $\\frac{1}{2}\\times 12\\times 4=24$ cm$^{2}$."
      },
      {
        "id": "2",
        "text": "A slanted side from $C$ that is not perpendicular to the line through $AB$ can replace $CH$ as the height."
      },
      {
        "id": "3",
        "text": "The same base–perpendicular-height product gives the area for every type of triangle."
      }
    ],
