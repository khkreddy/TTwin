    "options": {},
    "statements": [],
    "parts": [
      {
        "id": "i",
        "text": "Which claim correctly decides whether the grid can be tiled?",
        "marks": 1,
        "options": [
          {
            "id": "A",
            "text": "Yes. The grid has $20$ unit squares, and each column of height $4$ can be filled with two vertical $2$ by $1$ tiles."
          },
          {
            "id": "B",
            "text": "No. Any grid with a side of length $5$ cannot be tiled, even when the total number of squares is even."
          },
          {
            "id": "C",
            "text": "Yes, because every rectangle of unit squares can be tiled, with no check of area parity or a row-or-column plan."
          },
          {
            "id": "D",
            "text": "Call the tiling decision the label unit squares on the grid, and stop there."
