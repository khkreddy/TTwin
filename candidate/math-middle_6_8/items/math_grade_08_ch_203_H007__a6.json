    "stem": "Alok knows the number of machines and the days to finish a fixed print job are inversely proportional. With $4$ machines the job takes $18$ days. He needs the time when $6$ machines work on the same job.",
    "item_type": "structured",
    "options": {},
    "statements": [],
    "parts": [
      {
        "id": "i",
        "text": "Which claim correctly finds the time?",
        "marks": 1,
        "options": [
          {
            "id": "A",
            "text": "Keep the product constant: $4\\times18=6\\times t$, so $t=\\dfrac{72}{6}=12$ days."
          },
          {
            "id": "B",
            "text": "The constant product is only a label, so ignore the fixed job and pick any time."
          },
          {
            "id": "C",
            "text": "Scale time the same way as machines: $t=18\\times\\dfrac{6}{4}=27$ days, as if the job size need not stay fixed."
          },
          {
            "id": "D",
            "text": "The answer is $18$ days because $18$ is the only time printed in the stem."
          }
        ]
      },
      {
        "id": "ii",
        "text": "Give one reason for your choice.",
        "marks": 1
      }
    ],
