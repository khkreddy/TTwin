    "stem": "Vikram records goals in five football matches: $2$, $0$, $3$, dash (did not play), and $1$. He wants the mean goals per match played.\n\nWhich statements are correct?",
    "item_type": "three_statement",
    "options": {
      "A": "1 only",
      "B": "1 and 2 only",
      "C": "2 and 3 only",
      "D": "1, 2 and 3"
    },
    "statements": [
      {
        "id": "1",
        "text": "Include the observed $0$ in the sum and count that match; leave the dash out of the denominator, so the mean is $(2+0+3+1)\\div 4 = 1.5$."
      },
      {
        "id": "2",
        "text": "Drop the $0$ as if it were missing, and divide only by the three nonzero scores."
      },
      {
        "id": "3",
        "text": "Treat the dash as a fifth played match with value $0$."
      }
    ],
