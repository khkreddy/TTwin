    "parts": [
      {
        "id": "i",
        "text": "Which claim about the third length $x$ is correct?",
        "marks": 1,
        "options": [
          {
            "id": "A",
            "text": "The answer is the phrase fixed side lengths."
          },
          {
            "id": "B",
            "text": "$x$ must satisfy $3 < x < 17$, because $|10-7| < x < 10+7$ with the endpoints excluded."
          },
          {
            "id": "C",
            "text": "$x$ may equal $3$ or $17$ as well as any value between them."
          },
          {
            "id": "D",
            "text": "She must first construct the triangle with compass arcs, and only then decide which $x$ values are allowed."
          }
        ]
      },
