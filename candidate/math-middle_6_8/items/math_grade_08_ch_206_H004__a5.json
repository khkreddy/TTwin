    "stem": "Rachna fills a number pyramid. Each box is the sum of the two boxes directly below it. The top box is $50$. The bottom row is $10$, $c$, $4$, and the middle row is $a$, $b$. One local step alone does not fill every unknown box.",
    "item_type": "structured",
    "options": {},
    "statements": [],
    "parts": [
      {
        "id": "i",
        "text": "Which plan finds $c$?",
        "marks": 1,
        "options": [
          {
            "id": "A",
            "text": "Name the answer as the top box $50$, and stop."
          },
          {
            "id": "B",
            "text": "Solving for $c$ first decides what the pyramid sum rule must have been."
          },
          {
            "id": "C",
            "text": "Write $a=10+c$, $b=c+4$, and $a+b=50$, then solve those equations together to get $c=18$."
          },
          {
            "id": "D",
            "text": "Fill $a$ from $10$ alone by doubling $10$, then copy that plan for $b$."
          }
        ]
      },
