    "stem": "Pia's classroom floor plan is a large rectangle $10\\,\\mathrm{m}$ by $6\\,\\mathrm{m}$. It is split into Room L and Room R that share a straight side parallel to the $6\\,\\mathrm{m}$ sides. Room L has area $24\\,\\mathrm{m}^{2}$.",
    "item_type": "structured",
    "options": {},
    "statements": [],
    "parts": [
      {
        "id": "i",
        "text": "Which claim correctly finds the width of Room L along the $10\\,\\mathrm{m}$ side?",
        "marks": 1,
        "options": [
          {
            "id": "A",
            "text": "Width $= 24 \\div 6 = 4\\,\\mathrm{m}$."
          },
          {
            "id": "B",
            "text": "Width $= 24\\,\\mathrm{m}$, taking the printed area as the width."
          },
          {
            "id": "C",
            "text": "Width $= 24 \\times 6 = 144\\,\\mathrm{m}$."
          }
        ]
      },
      {
        "id": "ii",
        "text": "Give one reason for your choice.",
        "marks": 1
      }
    ],
