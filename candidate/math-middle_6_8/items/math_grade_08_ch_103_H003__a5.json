    "stem": "Rahul learns Gumulgal number names: urapon means $1$ and ukasar means $2$. Longer names are built as sums of these group words, so ukasar-urapon means $3$ and ukasar-ukasar means $4$. He wants the correct name for a count of $5$ sticks.",
    "item_type": "structured",
    "options": {},
    "statements": [],
    "parts": [
      {
        "id": "i",
        "text": "Which claim is correct?",
        "marks": 1,
        "options": [
          {
            "id": "A",
            "text": "The name for $5$ is ukasar-ukasar-urapon, because it is $2 + 2 + 1$."
          },
          {
            "id": "B",
            "text": "The name for $5$ is urapon, because urapon is the leftover word for any odd count."
          },
          {
            "id": "C",
            "text": "Any new string of syllables may be used for $5$, ignoring the known meanings of $1$ and $2$."
          }
        ]
      },
      {
        "id": "ii",
        "text": "Give one reason for your choice.",
        "marks": 1
      }
