    "stem": "Esha must divide ₹$90$ among three friends in the ratio $1 : 2 : 3$.",
    "item_type": "structured",
    "options": {},
    "statements": [],
    "parts": [
      {
        "id": "i",
        "text": "How should she find the three shares?",
        "marks": 1,
        "options": [
          {
            "id": "A",
            "text": "The answer is the phrase \"ratio terms\", with no rupee amounts computed."
          },
          {
            "id": "B",
            "text": "Treat the problem as two people sharing a work job, and add work rates instead of splitting ₹$90$."
          },
          {
            "id": "C",
            "text": "Add the terms $1+2+3=6$, then give $\\frac{1}{6}\\times 90$, $\\frac{2}{6}\\times 90$, and $\\frac{3}{6}\\times 90$, so ₹$15$, ₹$30$, and ₹$45$."
          },
          {
            "id": "D",
            "text": "Divide $90$ by each of $1$, $2$, and $3$ separately, getting $90$, $45$, and $30$."
          }
        ]
      },
      {
        "id": "ii",
        "text": "Give one reason for your choice.",
        "marks": 1
      }
