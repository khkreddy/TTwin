    "stem": "Arjun knows that $8$ divides $24$ and $8$ divides $40$.",
    "item_type": "structured",
    "options": {},
    "statements": [],
    "parts": [
      {
        "id": "i",
        "text": "Which claim keeps the direction of the divisibility rule straight for $24+40$ and for a split of a multiple of $8$?",
        "marks": 1,
        "options": [
          {
            "id": "A",
            "text": "$8$ divides $24+40=64$; a multiple of $8$ can still split into addends that are not both multiples of $8$."
          },
          {
            "id": "B",
            "text": "Because $8$ divides $64$, both addends in every split of $64$ must be multiples of $8$."
          },
          {
            "id": "C",
            "text": "$8$ divides $24+40$ when $8$ divides only one of $24$ or $40$."
          },
          {
            "id": "D",
            "text": "The same closure also applies when different divisors act on $24$ and $40$."
          }
        ]
      },
      {
        "id": "ii",
        "text": "Give one reason for your choice.",
        "marks": 1
      }
    ],
