    "stem": "Ira tests whether $64$ is a perfect square by subtracting consecutive odd numbers starting from $1$: $64-1=63$, $63-3=60$, $60-5=55$, and so on.",
    "item_type": "structured",
    "options": {},
    "statements": [],
    "parts": [
      {
        "id": "i",
        "text": "Which claim is correct?",
        "marks": 1,
        "options": [
          {
            "id": "A",
            "text": "Keep subtracting $1$, $3$, $5$, $\\ldots$, $15$ in order; reaching exactly $0$ after eight steps shows $64=8^{2}$."
          },
          {
            "id": "B",
            "text": "Call the process a sum of odd numbers and treat that label alone as the decision."
          },
          {
            "id": "C",
            "text": "Stop after any single subtraction and treat a later nonzero remainder as proof that $64$ is square."
          },
          {
            "id": "D",
            "text": "Decide from the printed digit $4$ in $64$ alone."
          }
        ]
      },
