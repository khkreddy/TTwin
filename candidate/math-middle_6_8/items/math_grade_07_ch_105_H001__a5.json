    "stem": "Pranav looks at the diagram. Straight lines $\\ell$ and $m$ lie on the same flat page and meet at point $P$. The angles at $P$ are labelled $1$, $2$, $3$ and $4$.",
    "item_type": "structured",
    "options": {},
    "statements": [],
    "parts": [
      {
        "id": "i",
        "text": "Which claim correctly names the lines and the angle structure at $P$?",
        "marks": 1,
        "options": [
          {
            "id": "A",
            "text": "Lines $\\ell$ and $m$ are intersecting, and their meeting at $P$ forms the four angles labelled $1$ to $4$."
          },
          {
            "id": "B",
            "text": "Lines $\\ell$ and $m$ can meet at two different points on the page if they are drawn longer."
          },
          {
            "id": "C",
            "text": "The four angles at $P$ are what force lines $\\ell$ and $m$ to meet."
          }
        ]
      },
      {
        "id": "ii",
        "text": "Give one reason for your choice.",
        "marks": 1
      }
    ],
