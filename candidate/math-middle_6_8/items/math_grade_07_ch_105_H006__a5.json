    "subtopic_id": "math/grade_07/ch_105/H006",
    "stem": "Nandini studies the figure. Lines $m$ and $n$ each carry a matching pair of arrow marks. Lines $u$ and $v$ meet with a small square at the meeting point.",
    "item_type": "structured",
    "options": {},
    "statements": [],
    "parts": [
      {
        "id": "i",
        "text": "Which reading of the marks is correct?",
        "marks": 1,
        "options": [
          {
            "id": "A",
            "text": "The arrow marks are labels only, with no parallel relation shown."
          },
          {
            "id": "B",
            "text": "The matching double arrow marks show $m \\parallel n$, and the small square shows that $u$ is perpendicular to $v$."
          },
          {
            "id": "C",
            "text": "The small square marks any sharp corner, not a right angle."
          },
          {
            "id": "D",
            "text": "Drawing the arrow marks is what creates lines $m$ and $n$."
          }
        ]
      },
      {
        "id": "ii",
        "text": "Give one reason for your choice.",
        "marks": 1
      }
    ],
