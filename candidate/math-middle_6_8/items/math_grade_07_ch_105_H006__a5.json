    "tables": [],
    "tikz": "\\begin{tikzpicture}[scale=0.9,font=\\sffamily\\small]\n  \\draw[thick] (0,2.4) -- (4.4,2.4) node[right] {$m$};\n  \\draw[thick] (0,1.4) -- (4.4,1.4) node[right] {$n$};\n  \\draw[->,thick] (1.6,2.4) -- (2.0,2.4);\n  \\draw[->,thick] (2.05,2.4) -- (2.45,2.4);\n  \\draw[->,thick] (1.6,1.4) -- (2.0,1.4);\n  \\draw[->,thick] (2.05,1.4) -- (2.45,1.4);\n  \\draw[thick] (0.4,-0.3) -- (3.8,-0.3) node[right] {$u$};\n  \\draw[thick] (2.0,-1.6) -- (2.0,0.9) node[above] {$v$};\n  \\draw (2.0,-0.3) rectangle (2.25,-0.05);\n\\end{tikzpicture}",
