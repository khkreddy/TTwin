    "options": {
      "A": "1 and 2 only",
      "B": "1 and 3 only",
      "C": "2 and 3 only",
      "D": "1, 2 and 3"
    },
    "statements": [
      {
        "id": "1",
        "text": "The mean is the balance point of the data; here $(1+1+2+8)/4=3$, not $4.5$."
      },
      {
        "id": "2",
        "text": "From $3$, total distance to the values below equals total distance to the values above."
      },
      {
        "id": "3",
        "text": "$4.5$ is the mean because the mean is always halfway between the extremes."
      }
