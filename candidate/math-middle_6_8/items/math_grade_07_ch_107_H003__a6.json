    "stem": "Pallavi looks at the diagram of three rods of lengths $6\\,\\mathrm{cm}$, $7\\,\\mathrm{cm}$ and $15\\,\\mathrm{cm}$. She asks whether they can be the side lengths of a triangle.",
    "item_type": "structured",
    "options": {},
    "statements": [],
    "parts": [
      {
        "id": "i",
        "text": "Which claim is correct?",
        "marks": 1,
        "options": [
          {
            "id": "A",
            "text": "The answer is $15\\,\\mathrm{cm}$, because that is the longest length."
          },
          {
            "id": "B",
            "text": "Yes, because each length is a positive whole number."
          },
          {
            "id": "C",
            "text": "No, because $6 + 7 = 13$ is not greater than $15$."
          },
          {
            "id": "D",
            "text": "First construct the triangle with compass and ruler; only then decide whether the sides exist."
          }
        ]
      },
