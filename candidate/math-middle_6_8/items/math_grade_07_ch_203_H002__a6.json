    "stem": "Sameer starts factorising $120$ as $8 \\times 15$ and wants a complete prime factorisation.",
    "item_type": "structured",
    "options": {},
    "statements": [],
    "parts": [
      {
        "id": "i",
        "text": "Which statement correctly finishes the work?",
        "marks": 1,
        "options": [
          {
            "id": "A",
            "text": "Rewrite $8$ as $2 \\times 2 \\times 2$ and $15$ as $3 \\times 5$, so $120 = 2 \\times 2 \\times 2 \\times 3 \\times 5$."
          },
          {
            "id": "B",
            "text": "$8 \\times 15$ is already complete, because both factors are whole numbers."
          },
          {
            "id": "C",
            "text": "Stop at $8 \\times 15$, because $120$ is printed as the starting number."
          },
          {
            "id": "D",
            "text": "Keep $8$ as it is and only split $15$, giving $120 = 8 \\times 3 \\times 5$."
          }
        ]
      },
      {
        "id": "ii",
        "text": "Give one reason for your choice.",
        "marks": 1
      }
