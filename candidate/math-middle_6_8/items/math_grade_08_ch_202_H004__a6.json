    "options": {},
    "statements": [],
    "parts": [
      {
        "id": "i",
        "text": "Which conclusion is correct?",
        "marks": 1,
        "options": [
          {
            "id": "A",
            "text": "Because $1.69<2<2.25$, it follows that $1.3<\\sqrt{2}<1.5$."
          },
          {
            "id": "B",
            "text": "Report $1.3$ and $1.5$ themselves as the value of $\\sqrt{2}$."
          },
          {
            "id": "C",
            "text": "Write $1.3<\\sqrt{2}<1.5$ using $-1.3$ and $-1.5$ as the trial bounds as well."
          },
          {
            "id": "D",
            "text": "Choose any two printed decimals and call their average $\\sqrt{2}$."
          }
        ]
