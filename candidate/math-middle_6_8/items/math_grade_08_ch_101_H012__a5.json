    "stem": "Jatin checks whether $700$ and $27000$ could be perfect cubes by using last-digit and trailing-zero patterns.",
    "item_type": "structured",
    "options": {},
    "statements": [],
    "parts": [
      {
        "id": "i",
        "text": "Which claim correctly applies those patterns?",
        "marks": 1,
        "options": [
          {
            "id": "A",
            "text": "$700$ can be a perfect cube because it ends in $0$, as some cubes do."
          },
          {
            "id": "B",
            "text": "$700$ cannot be a perfect cube because it ends in exactly two zeros, and trailing zeros in a perfect cube come in groups of three."
          },
          {
            "id": "C",
            "text": "$27000$ cannot be a perfect cube because it ends in $0$, and cubes never end in $0$."
          }
        ]
      },
