    "stem": "Vikram cuts six congruent equilateral paper triangles and joins them at a common point to build a regular hexagon.",
    "item_type": "structured",
    "options": {},
    "statements": [],
    "parts": [
      {
        "id": "i",
        "text": "Which claim explains why the assembly forms a regular hexagon?",
        "marks": 1,
        "options": [
          {
            "id": "A",
            "text": "Six congruent equilateral triangles fit around a common point because six $60^{\\circ}$ angles sum to $360^{\\circ}$, so the outer boundary has equal sides and equal $120^{\\circ}$ angles."
          },
          {
            "id": "B",
            "text": "The answer is the name regular hexagon, with no angle sum at the common point."
          },
          {
            "id": "C",
            "text": "Any six triangles around a common point form a regular hexagon, even when the triangles are not congruent and not equilateral."
          },
          {
            "id": "D",
            "text": "The same assembly also builds a regular pentagon from five such triangles around a common point."
          }
        ]
      },
      {
        "id": "ii",
        "text": "Give one reason for your choice.",
        "marks": 1
      }
    ],
