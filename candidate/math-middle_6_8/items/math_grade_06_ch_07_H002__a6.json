    "options": {
      "A": "1 and 2 only",
      "B": "1 and 3 only",
      "C": "2 and 3 only",
      "D": "1, 2 and 3"
    },
    "statements": [
      {
        "id": "1",
        "text": "Only Chirag's piece is a valid one-fifth, because the whole was split into equal-size parts."
      },
      {
        "id": "2",
        "text": "Both pieces are one-fifth, because each person took one of five pieces."
      },
      {
        "id": "3",
        "text": "Equal size of the parts, not the count of pieces alone, decides a fractional unit of one-fifth."
