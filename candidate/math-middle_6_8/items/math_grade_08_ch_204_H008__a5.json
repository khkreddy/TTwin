        "id": "i",
        "text": "Which claim correctly decides whether this arrangement is a valid mathematical net for a cube?",
        "marks": 1,
        "options": [
          {
            "id": "A",
            "text": "It is a valid cube net: the six squares can fold without overlap into the six faces of a cube, and joining flaps are not counted as faces."
          },
          {
            "id": "B",
            "text": "Accept it as a net just because it has six squares, even if those squares would overlap when folded."
          },
          {
            "id": "C",
            "text": "Count a cardboard joining flap as a seventh face of the mathematical net."
          }
        ]
      },
