    "options": {
      "A": "1 only",
      "B": "1 and 2 only",
      "C": "2 and 3 only",
      "D": "1, 2 and 3"
    },
    "statements": [
      {
        "id": "1",
        "text": "Food should be respected because farmers and other community members put time and effort into getting it from the farm to the plate."
      },
      {
        "id": "2",
        "text": "Regions with fewer kinds of food show more respect for farmers."
      },
      {
        "id": "3",
        "text": "It is fine to waste cheap food because cheap food took no farm or community work."
