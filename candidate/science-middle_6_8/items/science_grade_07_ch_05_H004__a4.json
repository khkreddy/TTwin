    "parts": [
      {
        "id": "i",
        "text": "Which claim about starting and continuing burning is best?",
        "marks": 1,
        "options": [
          {
            "id": "A",
            "text": "Burning needs fuel, oxygen, and enough heat to reach ignition temperature; under the glass the oxygen runs low, and wet paper needs more heating to reach ignition."
          },
          {
            "id": "B",
            "text": "Once lit, the candle needs only wax as fuel; oxygen and heat above ignition temperature are not needed for continued burning."
          },
          {
            "id": "C",
            "text": "Wet paper fails to catch fire because paper is never a fuel, wet or dry."
          }
        ]
      },
