    "stem": "Imtiaz wants the density of a small metal bolt. He will use a digital balance for mass and a partly filled measuring cylinder for volume by water displacement.",
    "item_type": "structured",
    "options": {},
    "statements": [],
    "parts": [
      {
        "id": "i",
        "text": "Which measurement procedure is correct before he uses the mass and volume data?",
        "marks": 1,
        "options": [
          {
            "id": "A",
            "text": "Zero the balance with nothing on the pan, find the bolt's mass, then read the cylinder rise after the dry bolt is fully submerged."
          },
          {
            "id": "B",
            "text": "Find the volume first by guessing from the bolt's outline, then skip the balance because mass is not needed."
          },
          {
            "id": "C",
            "text": "Weigh the bolt while it is still wet from an earlier rinse, and ignore the starting water level in the cylinder."
          }
        ]
      },
