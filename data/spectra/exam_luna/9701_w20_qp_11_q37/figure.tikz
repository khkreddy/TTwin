\begin{tikzpicture}[baseline, line width=0.8pt]
  % central carbon and methyl groups
  \draw (0,0) -- (-0.85,-0.5);
  \draw (0,0) -- (0,0.85);
  % bond to ketone carbonyl carbon
  \draw (0,0) -- (0.75,-0.02);
  % ketone C=O
  \draw (0.75,-0.02) -- (0.75,-0.72);
  \draw (0.82,-0.02) -- (0.82,-0.72);
  \node at (0.785,-0.92) {O};
  % bond to carboxylic acid carbonyl carbon
  \draw (0.75,-0.02) -- (1.45,0.38);
  % carboxylic acid C=O
  \draw (1.45,0.38) -- (1.45,1.08);
  \draw (1.52,0.38) -- (1.52,1.08);
  \node at (1.485,1.28) {O};
  % hydroxyl group
  \draw (1.45,0.38) -- (2.12,0.0);
  \node at (2.38,-0.05) {OH};
\end{tikzpicture}
